#!/bin/sh
# Pre-push hook — blokir push langsung ke branch main/master
# Dipasang dengan: cp hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

protected_branch="main"
current_branch=$(git symbolic-ref HEAD 2>/dev/null | sed 's/refs\/heads\///')

if [ "$current_branch" = "$protected_branch" ]; then
    echo ""
    echo "⛔  PUSH KE BRANCH '$protected_branch' TIDAK DIIZINKAN!"
    echo "    Buat branch dulu:  git checkout -b <nama-branch>"
    echo "    Lalu commit & push, dan buat Pull Request di GitHub."
    echo ""
    exit 1
fi

exit 0
