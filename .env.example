YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT=https://clips.gcp.my.id/oauth
YOUTUBE_EXPECTED_CHANNEL_ID=UCuqm8syvmu1DOqkwzy9usZA
YOUTUBE_TOKEN_FILE=app/youtube_token.json

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT=https://clips.gcp.my.id/tiktok-oauth
TIKTOK_EXPECTED_OPEN_ID=
TIKTOK_TOKEN_FILE=app/tiktok_token.json

# Meta developer app with the Threads use case (Threads-specific ID/secret).
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT=https://clips.gcp.my.id/threads-oauth
THREADS_TOKEN_FILE=app/threads_token.json
# Public HTTPS origin from which Meta can fetch deployed TOP 5 MP4 files.
THREADS_PUBLIC_BASE_URL=https://clips.gcp.my.id
# Reuse a protected existing Threads user-token configuration without copying tokens.
# THREADS_ENV_FILE=/home/isra/techbro/techbro-pipeline/.env
# Alternatively set THREADS_ACCESS_TOKEN and THREADS_USER_ID locally.

# Flask session key (set a long random string to persist sessions across restarts)
FLASK_SECRET_KEY=

# Required for /admin. Generate with werkzeug.security.generate_password_hash.
ADMIN_PASSWORD_HASH=
# SQLite queue file; relative paths are resolved from the repository root.
ADMIN_DB_PATH=app/data/admin.sqlite3
# Keep true for HTTPS. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true

# Media tools/model. YuNet model must be installed separately.
FACE_YUNET_MODEL=/tmp/face_yunet.onnx
PODCAST_FONT_DIR=/usr/share/fonts/truetype/dejavu
# Optional explicit override; defaults to PODCAST_FONT_DIR/DejaVuSans-Bold.ttf.
# PODCAST_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Set per command; do not hardcode an episode globally.
# Set PODCAST_WORK_DIR explicitly per command; do not hardcode an episode here.
